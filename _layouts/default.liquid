<!doctype html>

<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        {% comment %}
            Référencement : titre, description et image propres à chaque page.
            Une page peut définir « description » dans son en-tête ; sinon on en
            construit une à partir de ses données (Défi, régates) ou on prend celle du club.
        {% endcomment %}
        {% assign nom_club = site.data.club.nom %}
        {% if page.url == "/" %}
            {% assign titre_seo = nom_club | append: " (CVGV) : voile légère et habitable" %}
        {% elsif page.title %}
            {% assign titre_seo = page.title | append: " | CVGV" %}
        {% else %}
            {% assign titre_seo = nom_club %}
        {% endif %}

        {% if page.description %}
            {% assign description_seo = page.description %}
        {% elsif page.layout == "defi-pilours-sablaire" %}
            {% capture description_seo %}Classement {{ page.year }} du Défi Pilours-Sablaire, de Saint-Gilles-Croix-de-Vie à l'île d'Yeu : temps réels, temps compensés et règlement.{% endcapture %}
        {% elsif page.layout == "regate" %}
            {% capture description_seo %}{{ page.title }} : {{ page.dates }}{% if page.lieu %} à {{ page.lieu | remove: " (85)" }}{% endif %}. Avis de course, inscription et tableau officiel.{% endcapture %}
        {% else %}
            {% assign description_seo = "Club de voile à Saint-Gilles-Croix-de-Vie (Vendée) : voile légère pour enfants, ados et adultes, compétition, croisières et régates habitables." %}
        {% endif %}
        {% assign description_seo = description_seo | strip_newlines | strip %}

        {% if page.affiche %}
            {% assign image_seo = page.affiche %}
        {% else %}
            {% assign image_seo = "/assets/partage.png" %}
        {% endif %}
        {% assign url_seo = page.url | replace: "index.html", "" | prepend: site.url %}

        <title>{{ titre_seo }}</title>
        <meta name="description" content="{{ description_seo | escape }}" />
        <link rel="canonical" href="{{ url_seo }}" />
        {% if page.noindex %}<meta name="robots" content="noindex, follow" />{% endif %}
        <meta name="theme-color" content="#024e82" />

        <!-- Partage sur les réseaux sociaux -->
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="fr_FR" />
        <meta property="og:site_name" content="{{ nom_club }}" />
        <meta property="og:title" content="{% if page.url == '/' %}{{ nom_club }}{% else %}{{ page.title | default: nom_club | escape }}{% endif %}" />
        <meta property="og:description" content="{{ description_seo | escape }}" />
        <meta property="og:url" content="{{ url_seo }}" />
        <meta property="og:image" content="{{ image_seo | uri_escape | prepend: site.url }}" />
        <meta name="twitter:card" content="summary_large_image" />
        {% include donnees-structurees.html %}

        <!-- Favicon -->
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
        <link rel="manifest" href="/site.webmanifest" />

        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65"
            crossorigin="anonymous"
        />
        <!-- Change à chaque build pour forcer le rechargement des styles -->
        <link href="/assets/styles.css?v={{ site.time | date: '%s' }}" rel="stylesheet" />

        <!-- Matomo -->
        <script>
            var _paq = (window._paq = window._paq || []);
            /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
            _paq.push(["trackPageView"]);
            _paq.push(["enableLinkTracking"]);
            (function () {
                var u = "//analytics.cvgv.org/";
                _paq.push(["setTrackerUrl", u + "matomo.php"]);
                _paq.push(["setSiteId", "1"]);
                var d = document,
                    g = d.createElement("script"),
                    s = d.getElementsByTagName("script")[0];
                g.async = true;
                g.src = u + "matomo.js";
                s.parentNode.insertBefore(g, s);
            })();
        </script>
        <!-- End Matomo Code -->

        <script
            async
            src="https://cdn.jsdelivr.net/npm/es-module-shims@1/dist/es-module-shims.min.js"
            crossorigin="anonymous"
        ></script>
        <script type="importmap">
            {
                "imports": {
                    "bootstrap": "https://cdn.jsdelivr.net/npm/bootstrap@5.1.1/dist/js/bootstrap.bundle.min.js"
                }
            }
        </script>
        <script type="module">
            import * as bootstrap from "bootstrap";
        </script>

        <script
            src="https://kit.fontawesome.com/a5ea491b73.js"
            crossorigin="anonymous"
        ></script>
    </head>

    <body>
        <a class="lien-evitement" href="#contenu">Aller au contenu</a>

        <header id="banner">
            <div class="container py-2 py-md-3">
                <a
                    href="/"
                    class="d-flex align-items-center gap-3 gap-md-4 text-decoration-none"
                >
                    <img src="/assets/logo.svg" alt="" />
                    {% comment %} Le nom du club n'est le titre principal que sur l'accueil ; ailleurs, c'est le titre de la page. {% endcomment %}
                    {% if page.url == "/" %}
                        <h1 class="site-titre mb-0">Club de Voile de<br /> Saint‑Gilles‑Croix‑de‑Vie</h1>
                    {% else %}
                        <p class="site-titre mb-0">Club de Voile de<br /> Saint‑Gilles‑Croix‑de‑Vie</p>
                    {% endif %}
                </a>
            </div>
        </header>

        <nav class="navbar navbar-expand-lg sticky-top mb-4" id="menu" aria-label="Menu principal">
            <div class="container">
                <button
                    class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                >
                    <span class="navbar-toggler-icon" aria-hidden="true"></span>
                    <span class="ms-1 align-middle">Menu</span>
                </button>
                {% include annonce.html %}
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        {% for item in site.data.pages.toc %}
                            {% if item.children == null %}
                                <li class="nav-item">
                                    <a
                                        class="nav-link{% if page.url == item.url %} active{% endif %}"
                                        {% if page.url == item.url %} aria-current="page"{% endif %}
                                        href="{{ item.url }}"
                                        >
                                            {{ item.title }}
                                    </a>
                                </li>
                            {% else %}
                                <li class="nav-item dropdown d-none d-lg-block">
                                    <a class="nav-link dropdown-toggle{% if page.url contains item.url %} active{% endif %}" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        {{ item.title }}
                                    </a>
                                    <ul class="dropdown-menu">
                                        {% for child in item.children %}
                                            <li><a class="dropdown-item{% if page.url == child.url %} active{% endif %}"{% if page.url == child.url %} aria-current="page"{% endif %} href="{{ child.url }}">{{ child.title }}</a></li>
                                        {% endfor %}
                                    </ul>
                                </li>

                                <li class="nav-item d-block d-lg-none">
                                    <span class="nav-link nav-section{% if page.url contains item.url %} active{% endif %}">
                                        {{ item.title }}
                                    </span>
                                    <ul>
                                        {% for child in item.children %}
                                        <li class="nav-item">
                                            <a
                                                class="nav-link{% if page.url == child.url %} active{% endif %}"
                                                {% if page.url == child.url %} aria-current="page"{% endif %}
                                                href="{{ child.url }}"
                                                >
                                                    {{ child.title }}
                                            </a>
                                        </li>
                                        {% endfor %}
                                    </ul>
                                </li>
                            {% endif %}
                        {% endfor %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ site.data.club.calendrier_pdf }}">
                                <i class="fa-regular fa-calendar"></i>&nbsp;Calendrier {{ site.data.club.annee_civile }}<span class="visually-hidden"> (PDF)</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <div class="d-grid">
                                <a
                                    class="btn btn-boutique"
                                    href="{{ site.data.club.liens.boutique }}"
                                >
                                        <i class="fa-solid fa-basket-shopping"></i>&nbsp;Boutique
                                </a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <main id="contenu" tabindex="-1">
            {{ content }}
        </main>

        <div class="container">
            <footer
                class="d-flex flex-wrap justify-content-between align-items-center py-3 my-4 border-top"
            >
                <p class="col-md-4 mb-0 text-muted">CVGV</p>
                <p class="col-md-4 mb-0 text-muted">
                    Dernière mise à jour : {{ 'now' | date: '%d/%m/%Y à %H:%M:%S
                    %Z' }}
                </p>

                <ul class="nav col-md-4 justify-content-end">
                    <li class="nav-item">
                        <a
                            href="mailto:{{ site.data.club.email }}"
                            class="nav-link px-2 text-muted"
                            >Contact</a
                        >
                    </li>
                </ul>
            </footer>
        </div>
    </body>
</html>
