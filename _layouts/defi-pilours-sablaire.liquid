---
layout: default
---

{% comment %}
    Résultats lus depuis _data/defi-pilours-sablaire/<année>.yml
    (non publié lors du déploiement).
{% endcomment %}
{% assign year = page.year | append: "" %}
{% assign results = site.data["defi-pilours-sablaire"][year] | sort: "temps_compense" %}
{% assign result_pages = site.pages | where: "layout", "defi-pilours-sablaire" | sort: "year" | reverse %}

{% assign boats = results | map: "bateau" | uniq %}

<div class="container">
    <section class="page-banner rounded-3 p-3 p-md-4 mb-3">
        <div class="d-md-flex justify-content-between align-items-start gap-3">
            <div>
                <p class="page-banner-kicker mb-1">
                    <i class="fa-solid fa-stopwatch"></i> Résultats {{ page.year }}
                </p>
                <h1 class="h2 mb-3">Défi Pilours-Sablaire</h1>
            </div>
            {% if result_pages.size > 1 %}
                <nav class="d-flex flex-wrap gap-2 mb-3" aria-label="Années">
                    {% for result_page in result_pages %}
                        {% if result_page.year == page.year %}
                            <a class="btn btn-sm btn-light" aria-current="page" href="{{ result_page.url }}">{{ result_page.year }}</a>
                        {% else %}
                            <a class="btn btn-sm btn-outline-light" href="{{ result_page.url }}">{{ result_page.year }}</a>
                        {% endif %}
                    {% endfor %}
                </nav>
            {% endif %}
        </div>
        {% if results.size > 0 %}
            <dl class="defi-stats row g-2 mb-0">
                <div class="col-4 col-md-auto me-md-4">
                    <dt>Chronos</dt>
                    <dd>{{ results.size }}</dd>
                </div>
                <div class="col-4 col-md-auto me-md-4">
                    <dt>Bateaux</dt>
                    <dd>{{ boats.size }}</dd>
                </div>
                <div class="col-4 col-md-auto me-md-4">
                    <dt>Meilleur temps</dt>
                    <dd>{{ results.first.temps_compense }}</dd>
                </div>
            </dl>
        {% endif %}
        {% comment %} Période du défi : du 1er février au 31 octobre inclus. {% endcomment %}
        <p
            class="page-countdown d-none align-items-center gap-2 rounded-pill px-3 py-1 mt-3 mb-0"
            id="defi-countdown"
            data-start-month="2"
            data-start-day="1"
            data-end-month="10"
            data-end-day="31"
        >
            <i class="fa-solid fa-hourglass-half"></i>
            <span>
                <span class="defi-countdown-label d-none d-sm-inline"></span>
                <span class="defi-countdown-label-short d-sm-none"></span>
                <strong class="page-countdown-time"></strong>
            </span>
        </p>
    </section>

    {% if results.size > 0 %}
        <div class="table-responsive mb-4">
            <table class="table align-middle defi-results">
                <caption class="visually-hidden">Classement {{ page.year }}, du meilleur temps compensé au moins bon</caption>
                <thead>
                    <tr>
                        <th scope="col" class="text-center"><span aria-hidden="true">#</span><span class="visually-hidden">Rang</span></th>
                        <th scope="col">Bateau</th>
                        <th scope="col" class="d-none d-md-table-cell">Sens</th>
                        <th scope="col" class="d-none d-md-table-cell">Date</th>
                        <th scope="col" class="d-none d-md-table-cell">Temps réel</th>
                        <th scope="col" class="text-end">
                            <span class="d-none d-md-inline">Temps compensé</span>
                            <span class="d-md-none">Compensé</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for result in results %}
                        {% if result.depart == "Sablaire" %}
                            {% assign from = "Sablaire" %}
                            {% assign to = "Pilours" %}
                            {% assign arrow = "fa-arrow-right" %}
                        {% else %}
                            {% assign from = "Pilours" %}
                            {% assign to = "Sablaire" %}
                            {% assign arrow = "fa-arrow-left" %}
                        {% endif %}
                        <tr{% if forloop.first %} class="defi-winner"{% endif %}>
                            <td class="text-center defi-rank">
                                {% if forloop.first %}
                                    <i class="fa-solid fa-trophy defi-gold" title="1er"></i><span class="visually-hidden">1</span>
                                {% else %}
                                    {{ forloop.index }}
                                {% endif %}
                            </td>
                            <td>
                                <span class="fw-semibold">{{ result.bateau }}</span>
                                {% if result.modele %}
                                    <span class="text-muted">{{ result.modele }}</span>
                                {% endif %}
                                <div class="small text-muted d-md-none">
                                    <span class="text-nowrap"><i class="fa-solid {{ arrow }}" title="{{ from }} → {{ to }}"></i><span class="visually-hidden">De {{ from }} à {{ to }}, le</span> {{ result.date }}</span>
                                    <span aria-hidden="true">·</span> <span class="text-nowrap">réel {{ result.temps_reel }}</span>
                                </div>
                            </td>
                            <td class="d-none d-md-table-cell text-nowrap">
                                {{ from }} <i class="fa-solid fa-arrow-right-long text-muted mx-1"></i><span class="visually-hidden">vers</span> {{ to }}
                            </td>
                            <td class="d-none d-md-table-cell">{{ result.date }}</td>
                            <td class="d-none d-md-table-cell">{{ result.temps_reel }}</td>
                            <td class="text-end fw-semibold text-nowrap">{{ result.temps_compense }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="text-muted mb-4">Aucun résultat pour le moment.</p>
    {% endif %}

    <div class="row g-4 mb-4">
        <div class="col-lg-4 d-none d-lg-block">
            <img
                src="/assets/defi-pilours-sablaire-trophee.webp"
                alt="Trophée du Défi Pilours-Sablaire"
                class="img-fluid rounded-3 shadow-sm"
                loading="lazy"
            />
        </div>
        <div class="col-lg-8">
            <h2 class="h3">Règlement</h2>
            <div class="accordion" id="reglement">
                {% for rule in site.data["defi-pilours-sablaire-reglement"] %}
                    <div class="accordion-item">
                        <h3 class="accordion-header" id="reglement-titre-{{ forloop.index }}">
                            <button
                                class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#reglement-{{ forloop.index }}"
                                aria-expanded="false"
                                aria-controls="reglement-{{ forloop.index }}"
                            >
                                {{ forloop.index }}. {{ rule.titre }}
                            </button>
                        </h3>
                        <div
                            id="reglement-{{ forloop.index }}"
                            class="accordion-collapse collapse"
                            aria-labelledby="reglement-titre-{{ forloop.index }}"
                        >
                            <div class="accordion-body">{{ rule.texte }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var el = document.getElementById("defi-countdown");
        var label = el.querySelector(".defi-countdown-label");
        var shortLabel = el.querySelector(".defi-countdown-label-short");
        var time = el.querySelector(".page-countdown-time");
        var d = el.dataset;

        function start(year) {
            return new Date(year, d.startMonth - 1, d.startDay);
        }

        // Le défi se termine à la fin du dernier jour (minuit le lendemain).
        function end(year) {
            return new Date(year, d.endMonth - 1, Number(d.endDay) + 1);
        }

        function pad(n) {
            return String(n).padStart(2, "0");
        }

        function update() {
            var now = new Date();
            var year = now.getFullYear();
            var target, step;
            if (now < start(year)) {
                target = start(year);
                step = "Début";
            } else if (now < end(year)) {
                target = end(year);
                step = "Fin";
            } else {
                year += 1;
                target = start(year);
                step = "Début";
            }
            label.textContent = step + " du défi " + year + " dans";
            shortLabel.textContent = step + " " + year + " dans";

            var s = Math.floor((target - now) / 1000);
            var days = Math.floor(s / 86400);
            time.textContent =
                (days > 0 ? days + "j " : "") +
                pad(Math.floor((s % 86400) / 3600)) +
                "h " +
                pad(Math.floor((s % 3600) / 60)) +
                "m " +
                pad(s % 60) +
                "s";
        }

        update();
        el.classList.replace("d-none", "d-inline-flex");
        setInterval(update, 1000);
    })();
</script>
