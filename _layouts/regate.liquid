---
layout: default
---

{% comment %}
    Page dédiée à une régate. Tout le contenu vient de l'en-tête de la page :
    title, sous_titre, dates, debut, fin, lieu, affiche, note,
    inscriptions, communications et tableau (voir les pages de habitable/regates/).
{% endcomment %}
{% comment %}
    L'annulation est saisie dans le calendrier (_data/regates-habitables.yml).
    Plusieurs régates du calendrier peuvent partager cette page (ex. deux jours) :
    la page n'est annulée que si toutes le sont ; sinon on signale celles qui le sont.
{% endcomment %}
{% assign regates_page = site.data["regates-habitables"].regates | where: "page", page.url %}
{% assign regates_annulees = regates_page | where: "annulee", true %}
{% assign annulee = false %}
{% if regates_annulees.size > 0 and regates_annulees.size == regates_page.size %}
    {% assign annulee = true %}
{% endif %}
{% assign debut = page.debut | date: "%Y-%m-%d" %}
{% if page.fin %}
    {% assign fin = page.fin | date: "%Y-%m-%d" %}
{% else %}
    {% assign fin = debut %}
{% endif %}

{% comment %} Date de mise à jour : le document publié le plus récemment. {% endcomment %}
{% assign publications = "" | split: "" %}
{% for document in page.communications %}
    {% if document.publie %}
        {% assign publications = publications | push: document.publie %}
    {% endif %}
{% endfor %}
{% for rubrique in page.tableau %}
    {% for document in rubrique.documents %}
        {% if document.publie %}
            {% assign publications = publications | push: document.publie %}
        {% endif %}
    {% endfor %}
{% endfor %}
{% assign derniere_publication = nil %}
{% for publie in publications %}
    {% assign iso = publie | date: "%Y-%m-%dT%H:%M" %}
    {% if derniere_publication == nil or iso > derniere_publication %}
        {% assign derniere_publication = iso %}
    {% endif %}
{% endfor %}

<div class="container">
    <section class="page-banner regate-banner rounded-3 p-3 p-md-4 mb-4">
        <a class="regate-retour" href="/habitable/regates.html">
            <i class="fa-solid fa-arrow-left"></i> Calendrier des régates
        </a>
        <div class="regate-banner-corps{% unless page.affiche %} regate-sans-affiche{% endunless %}">
            {% if page.affiche %}
                <a
                    class="regate-affiche"
                    href="{{ page.affiche }}"
                    aria-label="Agrandir l'affiche"
                    data-bs-toggle="modal"
                    data-bs-target="#affiche-apercu"
                >
                    <img src="{{ page.affiche }}" alt="Affiche : {{ page.title }}" />
                    <span class="regate-affiche-zoom"><i class="fa-solid fa-magnifying-glass-plus"></i></span>
                </a>
            {% endif %}
            <div class="regate-banner-texte">
                {% if annulee %}
                    <p class="badge-annulee badge-annulee-grand mb-2"><i class="fa-solid fa-ban"></i> Régate annulée</p>
                {% endif %}
                <h1 class="h2 mb-1">{{ page.title }}</h1>
                {% if page.sous_titre %}
                    <p class="regate-sous-titre mb-2">{{ page.sous_titre }}</p>
                {% endif %}
                <ul class="regate-quand-ou list-unstyled mb-0">
                    <li><i class="fa-regular fa-calendar"></i> {{ page.dates }}</li>
                    {% if page.lieu %}
                        <li><i class="fa-solid fa-location-dot"></i> {{ page.lieu }}</li>
                    {% endif %}
                </ul>
            </div>
            <div class="regate-actions">
                <div class="d-flex flex-wrap gap-2">
                    {% unless annulee %}{% for inscription in page.inscriptions %}
                        {% capture url %}{% include lien.html lien=inscription.lien %}{% endcapture %}
                        <a class="btn btn-light" href="{{ url }}">
                            <i class="fa-solid fa-pen-to-square"></i> {{ inscription.titre | default: "S'inscrire" }}
                        </a>
                    {% endfor %}{% endunless %}
                    <a class="btn btn-outline-light" href="#tableau-officiel">
                        <i class="fa-solid fa-clipboard-list"></i> Tableau officiel
                    </a>
                </div>
            </div>
        </div>
    </section>

    {% if page.affiche %}
        {% comment %} Aperçu de l'affiche, ouvert par Bootstrap sans script supplémentaire. {% endcomment %}
        <div
            class="modal fade"
            id="affiche-apercu"
            tabindex="-1"
            aria-labelledby="affiche-apercu-titre"
            aria-hidden="true"
        >
            <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="affiche-apercu-titre">Affiche : {{ page.title }}</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body text-center">
                        <img loading="lazy" class="affiche-apercu-image" src="{{ page.affiche }}" alt="Affiche : {{ page.title }}" />
                    </div>
                    <div class="modal-footer">
                        <a class="btn btn-doc" href="{{ page.affiche }}" target="_blank" rel="noopener">
                            <i class="fa-solid fa-up-right-and-down-left-from-center"></i> Ouvrir en grand<span class="visually-hidden"> (nouvel onglet)</span>
                        </a>
                        <button type="button" class="btn btn-boutique" data-bs-dismiss="modal">Fermer</button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% if annulee %}
        <div class="alerte-annulation" role="note">
            <i class="fa-solid fa-ban"></i>
            <div>
                <strong>Cette régate est annulée.</strong>
                {{ regates_annulees | map: "motif" | compact | uniq | join: " " }}
            </div>
        </div>
    {% elsif regates_annulees.size > 0 %}
        {% for regate in regates_annulees %}
            <div class="alerte-annulation" role="note">
                <i class="fa-solid fa-ban"></i>
                <div>
                    <strong>{{ regate.nom }} ({{ regate.dates }}) est annulée.</strong>
                    {% if regate.motif %}{{ regate.motif }}{% endif %}
                </div>
            </div>
        {% endfor %}
        {% assign regates_maintenues = regates_page | where_exp: "regate", "regate.annulee != true" %}
        {% for regate in regates_maintenues %}
            <div class="alerte-maintenue" role="note">
                <i class="fa-solid fa-circle-check"></i>
                <div>
                    <strong>{{ regate.nom }} ({{ regate.dates }}) est maintenue.</strong>
                </div>
            </div>
        {% endfor %}
    {% endif %}

    {% if page.note %}
        <p class="regate-note">
            <i class="fa-solid fa-circle-info"></i> {{ page.note }}
        </p>
    {% endif %}

    <section class="tableau-officiel mb-5" id="tableau-officiel">
        <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
            <h2 class="h3 mb-0"><i class="fa-solid fa-clipboard-list"></i> Tableau officiel</h2>
            {% if derniere_publication %}
                <p class="tableau-maj mb-0">
                    Mis à jour le {{ derniere_publication | date: "%d/%m à %Hh%M" }}
                </p>
            {% endif %}
        </div>

        <h3 class="tableau-rubrique">Communications du comité de course (Avenants, …)</h3>
        {% if page.communications.size > 0 %}
            {% comment %}
                Plus récente en premier. On trie sur une clé normalisée car « publie »
                peut être une date seule ou une date avec heure.
            {% endcomment %}
            {% assign cles = "" | split: "" %}
            {% for document in page.communications %}
                {% capture cle %}{{ document.publie | date: "%Y-%m-%dT%H:%M" }}|{{ forloop.index0 }}{% endcapture %}
                {% assign cles = cles | push: cle %}
            {% endfor %}
            {% assign cles = cles | sort | reverse %}
            {% assign communications = "" | split: "" %}
            {% for cle in cles %}
                {% assign index = cle | split: "|" | last | plus: 0 %}
                {% assign communications = communications | push: page.communications[index] %}
            {% endfor %}
            {% include tableau-documents.html documents=communications %}
        {% else %}
            <p class="tableau-vide">Aucune communication pour le moment.</p>
        {% endif %}

        {% for rubrique in page.tableau %}
            <h3 class="tableau-rubrique">{{ rubrique.rubrique }}</h3>
            {% include tableau-documents.html documents=rubrique.documents %}
        {% endfor %}
    </section>
</div>

<script>
    (function () {
        // Badge « Nouveau » pendant 48 h après la publication.
        var now = new Date();
        document.querySelectorAll(".tableau-document[data-publie]").forEach(function (el) {
            var publie = new Date(el.dataset.publie);
            if (now - publie >= 0 && now - publie < 48 * 3600 * 1000) {
                el.classList.add("tableau-document-nouveau");
            }
        });
    })();
</script>
